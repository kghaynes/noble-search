# Noble Search settings. Copy this file to .env and edit it:   cp .env.example .env
# .env is never committed to git. API keys are NOT set here — enter them in the app's Settings page.

# Your time zone (used for the daily search schedule). List: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=America/New_York

# Who can open the app.
#   127.0.0.1 = only this computer (safest, the default)
#   0.0.0.0   = any device on your home network (then set APP_PASSWORD below)
BIND_ADDRESS=127.0.0.1

# Port on your computer. Open http://localhost:8093 in a browser.
HOST_PORT=8093

# Optional password for the web page (user name can be anything). Strongly recommended if BIND_ADDRESS=0.0.0.0.
APP_PASSWORD=

# Days a job stays listed before it (and its drafts) are deleted. Jobs you mark Interested/Applied/Interviewing/Offer are kept.
MAX_AGE_DAYS=30

# Advanced, optional: a local AI model server (Ollama) instead of the Claude API. Can also be set in Settings.
# host.docker.internal = "the computer Docker is running on".
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=
